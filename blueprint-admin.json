{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/edit.php?post_type=product",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/infinite-sports-nutrition-demo/main/isn.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/infinite-sports-nutrition-demo/main/images.zip"
      },
      "extractToPath": "/wordpress"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/isn-setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/infinite-sports-nutrition-demo/main/setup.php"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/isn-demo.php",
      "data": "<?php\n// Demo: photos are already web-sized, so don't make thumbnails.\nadd_filter( 'woocommerce_resize_images', '__return_false' );\nadd_filter( 'woocommerce_background_image_regeneration', '__return_false' );\n"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/isn-admin-demo.php",
      "data": "<?php\n// Admin demo link: WooCommerce sends the first admin visit to its setup checklist.\n// Send it to the product list instead, once.\nadd_action( 'admin_init', function () {\n\tif ( ( $_GET['page'] ?? '' ) === 'wc-admin' && empty( $_GET['path'] ) && ! get_option( 'isn_demo_landed' ) ) {\n\t\tupdate_option( 'isn_demo_landed', 1 );\n\t\twp_safe_redirect( admin_url( 'edit.php?post_type=product' ) );\n\t\texit;\n\t}\n} );\n"
    },
    {
      "step": "runPHP",
      "code": "<?php define( 'ISN_FAST', true ); require '/wordpress/isn-setup.php';"
    }
  ]
}
